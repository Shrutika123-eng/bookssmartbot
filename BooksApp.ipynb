import streamlit as st
from langchain_openai import ChatOpenAI
import io
import pandas as pd
import pymupdf

# -------------------------
# Config
# -------------------------
st.set_page_config(page_title="Smart Books Assistant", page_icon="📚")

st.title("📚 Smart Books Assistant")

# -------------------------
# API Key
# -------------------------
api_key = st.text_input("Enter OpenAI API Key", type="password")

def get_llm():
    return ChatOpenAI(model="gpt-4o-mini", api_key=api_key)

# -------------------------
# File processing
# -------------------------
def read_pdf(file):
    doc = pymupdf.open(stream=file.read(), filetype="pdf")
    return "\n".join(page.get_text() for page in doc)

def read_txt(file):
    return file.read().decode("utf-8")

# -------------------------
# Upload
# -------------------------
uploaded_file = st.file_uploader("Upload a book", type=["pdf", "txt"])

if uploaded_file:
    if uploaded_file.name.endswith(".pdf"):
        text = read_pdf(uploaded_file)
    else:
        text = read_txt(uploaded_file)

    st.success("Book loaded ✅")

    # -------------------------
    # Ask question
    # -------------------------
    question = st.text_input("Ask something about the book")

    if question and api_key:
        llm = get_llm()

        prompt = f"""
        Answer the question based on this book content:

        BOOK:
        {text[:5000]}

        QUESTION:
        {question}
        """

        response = llm.invoke(prompt)
        st.write(response.content)